# Copy this file to .env and fill in real values locally.
# .env itself must NEVER be committed (see .gitignore).

# --- Database ---
# Local dev: SQLite (file-based, no server needed)
DATABASE_URL=sqlite:///./taskflow.db
# Deployment: managed PostgreSQL (per CLAUDE.md — SQLite is local-only)
# DATABASE_URL=postgresql://user:password@host:5432/taskflow

# --- LLM provider for the AI dependency copilot (BUILD_SPEC.md §5) ---
# Provider choice is an escalation item (BUILD_SPEC.md §10) — confirm
# with me before this becomes a documented commitment.
LLM_API_KEY=sk-REPLACE_ME
LLM_MODEL_NAME=REPLACE_ME

# --- CORS (BUILD_SPEC.md Phase 3 checklist) ---
# Must be the frontend's actual origin, never "*".
FRONTEND_ORIGIN=http://localhost:5173

# --- App ---
# Used by scheduler.py to anchor unconstrained tasks (BUILD_SPEC.md §3.2)
# Normally set by the seed script at runtime — override only for testing.
# BOARD_START_DATE=2026-01-01
